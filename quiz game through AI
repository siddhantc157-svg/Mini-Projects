# ==========================================
# DISPLAY QUIZ CATEGORIES
# ==========================================

def show_quizzes():

    print("\n==========================================")
    print("             QUIZ CATEGORIES")
    print("==========================================")

    for key, quiz in quizzes.items():
        print(f"{key}. {quiz['name']}")

    print("Q. Quit")


# ==========================================
# PLAY QUIZ
# ==========================================

def play_quiz(quiz):

    score = 0
    total_questions = len(quiz["questions"])

    print("\n==========================================")
    print(f"          {quiz['name']}")
    print("==========================================")

    for number, question in enumerate(quiz["questions"], start=1):

        print(f"\nQuestion {number}/{total_questions}")
        print(question["question"])

        # Display options
        letters = ["A", "B", "C", "D"]

        for i, option in enumerate(question["options"]):
            print(f"{letters[i]}. {option}")

        # Get answer
        while True:

            user_answer = input("\nYour answer (A/B/C/D): ").upper().strip()

            if user_answer in letters:
                break

            print("❌ Invalid input! Please enter A, B, C, or D.")

        # Check answer
        if user_answer == question["answer"]:

            print("✅ Correct!")
            score += 1

        else:

            correct_index = letters.index(question["answer"])
            correct_answer = question["options"][correct_index]

            print("❌ Wrong!")
            print(f"Correct answer: {question['answer']}. {correct_answer}")

    # Final result
    percentage = (score / total_questions) * 100

    print("\n==========================================")
    print("              QUIZ RESULT")
    print("==========================================")

    print(f"Score      : {score}/{total_questions}")
    print(f"Percentage : {percentage:.2f}%")

    if percentage == 100:
        print("🏆 Excellent! Perfect score!")

    elif percentage >= 75:
        print("🎉 Great job!")

    elif percentage >= 50:
        print("👍 Good effort!")

    else:
        print("📚 Keep practicing!")

    print("==========================================")


# ==========================================
# MAIN PROGRAM
# ==========================================

def main():

    print("\n==========================================")
    print("          🎮 MULTI QUIZ GAME")
    print("==========================================")

    while True:

        show_quizzes()

        choice = input("\nChoose a quiz: ").upper().strip()

        if choice == "Q":

            print("\nThanks for playing! 👋")
            break

        if choice in quizzes:

            play_quiz(quizzes[choice])

            again = input(
                "\nDo you want to choose another quiz? (Y/N): "
            ).upper().strip()

            if again != "Y":

                print("\nThanks for playing! 👋")
                break

        else:

            print("❌ Invalid choice! Please select a quiz from the menu.")


# ==========================================
# START GAME
# ==========================================

if __name__ == "__main__":
    main()
