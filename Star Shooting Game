import pygame
import random
import sys

SCREEN_WIDTH = 480
SCREEN_HEIGHT = 640
FPS = 60

PLAYER_SPEED = 6
BULLET_SPEED = 9
ENEMY_MIN_SPEED = 2
ENEMY_MAX_SPEED = 4
ENEMY_SPAWN_MS = 700  

BLACK = (10, 10, 20)
WHITE = (240, 240, 240)
CYAN = (80, 220, 255)
RED = (220, 60, 60)
YELLOW = (240, 200, 40)
GRAY = (120, 120, 120)


class Star:
    """Simple background star for a parallax scrolling effect."""

    def __init__(self):
        self.x = random.randint(0, SCREEN_WIDTH)
        self.y = random.randint(0, SCREEN_HEIGHT)
        self.speed = random.uniform(1, 3)
        self.size = random.choice([1, 1, 2])

    def update(self):
        self.y += self.speed
        if self.y > SCREEN_HEIGHT:
            self.y = 0
            self.x = random.randint(0, SCREEN_WIDTH)

    def draw(self, screen):
        pygame.draw.circle(screen, WHITE, (int(self.x), int(self.y)), self.size)


class Player:
    def __init__(self):
        self.width = 40
        self.height = 30
        self.x = SCREEN_WIDTH // 2 - self.width // 2
        self.y = SCREEN_HEIGHT - 60
        self.speed = PLAYER_SPEED
        self.lives = 3
        self.cooldown = 0  # frames until next shot allowed

    @property
    def rect(self):
        return pygame.Rect(self.x, self.y, self.width, self.height)

    def move(self, keys):
        if keys[pygame.K_LEFT] or keys[pygame.K_a]:
            self.x -= self.speed
        if keys[pygame.K_RIGHT] or keys[pygame.K_d]:
            self.x += self.speed
        self.x = max(0, min(SCREEN_WIDTH - self.width, self.x))

    def update(self):
        if self.cooldown > 0:
            self.cooldown -= 1

    def can_shoot(self):
        return self.cooldown == 0

    def shoot(self):
        self.cooldown = 12  # frames between shots
        cx = self.x + self.width // 2
        return Bullet(cx, self.y)

    def draw(self, screen):
        # Simple triangular ship
        tip = (self.x + self.width // 2, self.y)
        left = (self.x, self.y + self.height)
        right = (self.x + self.width, self.y + self.height)
        pygame.draw.polygon(screen, CYAN, [tip, left, right])
        pygame.draw.polygon(screen, WHITE, [tip, left, right], 2)


class Bullet:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.radius = 4
        self.speed = BULLET_SPEED
        self.alive = True

    @property
    def rect(self):
        return pygame.Rect(self.x - self.radius, self.y - self.radius,
                            self.radius * 2, self.radius * 2)

    def update(self):
        self.y -= self.speed
        if self.y < -10:
            self.alive = False

    def draw(self, screen):
        pygame.draw.circle(screen, YELLOW, (int(self.x), int(self.y)), self.radius)


class Enemy:
    def __init__(self):
        self.size = random.randint(24, 40)
        self.x = random.randint(0, SCREEN_WIDTH - self.size)
        self.y = -self.size
        self.speed = random.uniform(ENEMY_MIN_SPEED, ENEMY_MAX_SPEED)
        self.alive = True

    @property
    def rect(self):
        return pygame.Rect(self.x, self.y, self.size, self.size)

    def update(self):
        self.y += self.speed
        if self.y > SCREEN_HEIGHT:
            self.alive = False

    def draw(self, screen):
        pygame.draw.rect(screen, RED, self.rect, border_radius=4)
        pygame.draw.rect(screen, WHITE, self.rect, 2, border_radius=4)


class SpaceShooterGame:
    def __init__(self):
        pygame.init()
        self.screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
        pygame.display.set_caption("Space Shooter")
        self.clock = pygame.time.Clock()
        self.font = pygame.font.SysFont("consolas", 22)
        self.big_font = pygame.font.SysFont("consolas", 46, bold=True)

        self.stars = [Star() for _ in range(80)]
        self.spawn_event = pygame.USEREVENT + 1
        pygame.time.set_timer(self.spawn_event, ENEMY_SPAWN_MS)

        self.reset()

    def reset(self):
        self.player = Player()
        self.bullets = []
        self.enemies = []
        self.score = 0
        self.game_over = False
        self.paused = False

    def handle_input(self):
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()

            if event.type == self.spawn_event and not self.game_over and not self.paused:
                self.enemies.append(Enemy())

            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    pygame.quit()
                    sys.exit()
                if event.key == pygame.K_p and not self.game_over:
                    self.paused = not self.paused
                if event.key == pygame.K_r and self.game_over:
                    self.reset()
                if event.key == pygame.K_SPACE and not self.game_over and not self.paused:
                    if self.player.can_shoot():
                        self.bullets.append(self.player.shoot())

        keys = pygame.key.get_pressed()
        if not self.game_over and not self.paused:
            self.player.move(keys)
            if keys[pygame.K_SPACE] and self.player.can_shoot():
                self.bullets.append(self.player.shoot())

    def update(self):
        for star in self.stars:
            star.update()

        if self.game_over or self.paused:
            return

        self.player.update()

        for bullet in self.bullets:
            bullet.update()
        self.bullets = [b for b in self.bullets if b.alive]

        for enemy in self.enemies:
            enemy.update()
        self.enemies = [e for e in self.enemies if e.alive]

        # Bullet vs enemy collisions
        for enemy in self.enemies:
            for bullet in self.bullets:
                if bullet.alive and enemy.alive and bullet.rect.colliderect(enemy.rect):
                    bullet.alive = False
                    enemy.alive = False
                    self.score += 10
        self.bullets = [b for b in self.bullets if b.alive]
        self.enemies = [e for e in self.enemies if e.alive]

        # Player vs enemy collisions
        for enemy in self.enemies:
            if enemy.rect.colliderect(self.player.rect):
                enemy.alive = False
                self.player.lives -= 1
                if self.player.lives <= 0:
                    self.game_over = True
        self.enemies = [e for e in self.enemies if e.alive]

    def draw_hud(self):
        score_surf = self.font.render(f"Score: {self.score}", True, WHITE)
        self.screen.blit(score_surf, (10, 10))

        lives_surf = self.font.render(f"Lives: {self.player.lives}", True, WHITE)
        self.screen.blit(lives_surf, (SCREEN_WIDTH - lives_surf.get_width() - 10, 10))

    def draw_center_text(self, title, subtitle):
        overlay = pygame.Surface((SCREEN_WIDTH, SCREEN_HEIGHT), pygame.SRCALPHA)
        overlay.fill((0, 0, 0, 170))
        self.screen.blit(overlay, (0, 0))

        title_surf = self.big_font.render(title, True, WHITE)
        title_rect = title_surf.get_rect(center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 - 20))
        self.screen.blit(title_surf, title_rect)

        sub_surf = self.font.render(subtitle, True, WHITE)
        sub_rect = sub_surf.get_rect(center=(SCREEN_WIDTH // 2, SCREEN_HEIGHT // 2 + 30))
        self.screen.blit(sub_surf, sub_rect)

    def draw(self):
        self.screen.fill(BLACK)

        for star in self.stars:
            star.draw(self.screen)

        for bullet in self.bullets:
            bullet.draw(self.screen)

        for enemy in self.enemies:
            enemy.draw(self.screen)

        self.player.draw(self.screen)
        self.draw_hud()

        if self.paused and not self.game_over:
            self.draw_center_text("PAUSED", "Press P to resume")

        if self.game_over:
            self.draw_center_text("GAME OVER", f"Score: {self.score}  |  Press R to restart")

        pygame.display.flip()

    def run(self):
        while True:
            self.handle_input()
            self.update()
            self.draw()
            self.clock.tick(FPS)


if __name__ == "__main__":
    SpaceShooterGame().run()
